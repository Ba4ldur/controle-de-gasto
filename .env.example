# =====================================================================
# Attivare Reforma Intelligence — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA commite o arquivo `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# Frontend (Vite) — expostas ao navegador.
# Use SEMPRE a chave "anon"/"publishable". NUNCA a service_role aqui.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Modo demonstração: quando "true", o app usa dados fictícios e gera
# diagnósticos de exemplo sem chamar Supabase/OpenAI. Útil para avaliar o
# fluxo completo sem infraestrutura. Deixe "false" em produção.
VITE_DEMO_MODE=false

# ---------------------------------------------------------------------
# Edge Function `generate-diagnosis` (configuradas no Supabase, NÃO no
# frontend). Defina via: supabase secrets set NOME=valor
# ---------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-apenas-no-servidor
